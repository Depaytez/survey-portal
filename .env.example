# ---------------------------------------------------------------------------
# African Tourism Research Platform — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed. This file (.env.example)
# has no real secrets and should always be kept up to date whenever a new
# environment variable is introduced, so anyone setting up the project has an
# exact, current checklist.
#
# All values below come from your Supabase project dashboard:
# https://supabase.com/dashboard/project/<your-project-ref>
# ---------------------------------------------------------------------------

# --- Client-exposed (safe for the browser — NEXT_PUBLIC_ vars are bundled
#     into client-side JavaScript, so never put a secret behind this prefix) ---

# Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings -> API Keys -> "anon" / "publishable" key
# Safe to expose publicly — Row Level Security is what actually protects data,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (NEVER add a NEXT_PUBLIC_ prefix to these,
#     never log them, never commit them) ---

# Settings -> API Keys -> "service_role" / "secret" key
# Bypasses every Row Level Security policy. Used only in trusted server-only
# code (src/lib/supabase/admin.ts, scripts/create-admin.ts). If this key ever
# leaks, rotate it immediately from the same Settings -> API Keys page.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local tooling only (not read by the app at runtime; used by the
#     Supabase CLI to push migrations and generate types) ---

# Account -> Access Tokens -> Generate new token, at https://supabase.com/dashboard/account/tokens
# Grants access to every project in your Supabase account via the CLI/Management
# API — treat it like a password. Not consumed by Next.js, so it does not need
# a NEXT_PUBLIC_ or server-safe naming convention, but it must stay out of git
# exactly like the keys above.
supabase_personal_access_token=

# ---------------------------------------------------------------------------
# Step-by-step: setting up a fresh Supabase project for this app
# ---------------------------------------------------------------------------
# 1. Create a project at https://supabase.com/dashboard (or reuse an existing
#    one) and wait for it to finish provisioning.
# 2. Project Settings -> Data API: copy "Project URL" into
#    NEXT_PUBLIC_SUPABASE_URL.
# 3. Project Settings -> API Keys: copy the "anon"/"publishable" key into
#    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, and the "service_role"/"secret" key
#    into SUPABASE_SERVICE_ROLE_KEY.
# 4. Account (top-right avatar) -> Access Tokens -> Generate new token: paste
#    it into supabase_personal_access_token. This is what lets the CLI push
#    migrations on your behalf (see step 6).
# 5. Install the Supabase CLI if you don't already have it: `npx supabase --version`
#    works without a global install.
# 6. Link and push the schema:
#      npx supabase link --project-ref <your-project-ref>
#      npx supabase db push
#    (<your-project-ref> is the subdomain in your Project URL, e.g. the
#    "abcdefgh" in https://abcdefgh.supabase.co)
# 7. Generate TypeScript types to match the schema:
#      npx supabase gen types typescript --linked > src/types/database.types.ts
# 8. Create the first admin account:
#      npm run create-admin -- --email=you@example.com --name="Your Name"
#    This prints a one-time password — save it, then sign in at /admin/login.
#    (Once you have one admin, additional ones can be invited in-app from
#    /admin/admins instead — no script needed for those.)
# 9. Authentication -> URL Configuration, in the Supabase dashboard: add
#    every origin this app runs on to "Redirect URLs" (e.g.
#    http://localhost:3000/auth/callback for local dev, and
#    https://your-production-domain/auth/callback once deployed). Without
#    this, the admin-invite and "forgot password" email links will fail —
#    Supabase only honors a redirectTo that's on this allowlist.
# ---------------------------------------------------------------------------
